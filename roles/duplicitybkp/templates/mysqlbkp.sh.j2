#!/bin/bash
##create mysql dump for any selected database.
###******************************************************************************************###
# Реквизиты содержат секреты: xtrace включаем только после их присваивания,
# чтобы пароль не попал в лог cron.
USER="{{ mysqlbkp_user }}"
PASSWD={{ mysqlbkp_pass | quote }}
MYSQLSVRHOST="{{ mysqlbkp_host }}"
PORT="{{ mysqlbkp_port|d('3306') }}"
# example string mysqlbkp_db_and_userdir [db1]=/user/home1\n[db2]=/user/home2
BkpListFile="/etc/{{ bkpprefix }}mysqlbkp/mysql"
###******************************************************************************************###
set -x
MYSQLDUMP="$(command -v mysqldump)"
GZIP="$(command -v gzip)"
DATE="$(command -v date)"
NOW=$($DATE +%Y%m%d_%H%M%S)
echo "+ mysql backup: host=${MYSQLSVRHOST} port=${PORT} user=${USER} list=${BkpListFile}" >&2
###******************************************************************************************###
create_backup_act()
{
  while read line;
  do
    # Строка списка и команда с паролем не должны попадать в xtrace.
    set +x
    if [ -z "$line" ]; then return; fi
    read -r -a BkpItemAsArray <<< "$line"
    DbName=${BkpItemAsArray[0]}
    BackupPath=${BkpItemAsArray[1]}
    FILE="${BackupPath}/${DbName}.sql.gz"
    echo "+ ${MYSQLDUMP} -f -h ${MYSQLSVRHOST} -P ${PORT} -u ${USER} -p*** --single-transaction ${DbName} | gzip -9 > ${FILE}" >&2
    ( umask 077; $MYSQLDUMP -f -h "$MYSQLSVRHOST" -P "$PORT" -u"$USER" -p"$PASSWD" --single-transaction "${DbName}" | $GZIP -9 > "$FILE" )
    if [ -f "$FILE" ]; then chmod 600 "$FILE"; fi
    set -x
    ARCHIVE_SIZE=$(du -sh "$FILE")
    rc=$?; if [[ $rc == 0 ]]; then echo "$NOW: Backup database $DbName was created, archive size $ARCHIVE_SIZE"; fi
  done < $BkpListFile
}

##_MAIN_
  create_backup_act;
exit 0
